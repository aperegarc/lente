# ============================================================
# lente · Variables de entorno
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env.local (en local)
# 2. Rellena los valores reales
# 3. NUNCA subas .env.local a Git (ya está en .gitignore)
# 4. En Vercel, copia estas variables en Settings → Environment Variables
# ============================================================

# ----- SUPABASE -----
# Encontrar en: https://supabase.com/dashboard → tu proyecto → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- ANTHROPIC (Claude) -----
# Encontrar en: https://console.anthropic.com/settings/keys
# IMPORTANTE: Carga saldo en https://console.anthropic.com/settings/billing
ANTHROPIC_API_KEY=sk-ant-api03-...

# ----- OPENAI (Embeddings) -----
# Encontrar en: https://platform.openai.com/api-keys
# IMPORTANTE: Carga saldo en https://platform.openai.com/account/billing/overview
OPENAI_API_KEY=sk-proj-...

# ----- SEGURIDAD -----
# Genera una cadena aleatoria de 48 caracteres
# PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 48 | % {[char]$_})
CRON_SECRET=GENERATE-A-RANDOM-48-CHARACTER-STRING

# ----- DEPLOYMENT (Vercel lo rellena automáticamente) -----
# NO TOCAR en local. En Vercel se llena solo.
# DEPLOYMENT_URL=
