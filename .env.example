# ----- SUPABASE -----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here-never-commit

# ----- ANTHROPIC (Claude) -----
ANTHROPIC_API_KEY=sk-ant-api03-...

# ----- SEGURIDAD -----
CRON_SECRET=GENERATE-A-RANDOM-48-CHARACTER-STRING

