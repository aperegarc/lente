# ----- ANTHROPIC (Claude) -----
# Encontrar en: https://console.anthropic.com/settings/keys
# IMPORTANTE: Carga saldo en https://console.anthropic.com/settings/billing
ANTHROPIC_API_KEY=sk-ant-api03-...

# ----- OPENAI (opcional, ya no usado por generate) -----
# Antes servía para embeddings; el pipeline actual solo usa Claude.
# OPENAI_API_KEY=

# ----- FINNHUB (opcional, ingest de noticias) -----
# https://finnhub.io/register — no exponer la key al frontend
# FINNHUB_API_KEY=

# ----- SEGURIDAD -----
# Genera una cadena aleatoria de 48 caracteres
# PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 48 | % {[char]$_})
CRON_SECRET=GENERATE-A-RANDOM-48-CHARACTER-STRING

# ----- STRIPE (suscripciones) -----
# Ver guía: STRIPE_SETUP.md
# STRIPE_SECRET_KEY=sk_live_... o sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...

# ----- DEPLOYMENT (Vercel lo rellena automáticamente) -----
# NO TOCAR en local. En Vercel se llena solo.
# DEPLOYMENT_URL=
