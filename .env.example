# ============================================================
# lente · Variables de entorno
# ============================================================
# Copia este archivo como .env.local para desarrollo local,
# y pega estas mismas variables en Vercel → Settings → Environment Variables
# para producción.
# ============================================================

# ----- Supabase -----
# Panel de Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...  # anon public key (la que se puede exponer)
SUPABASE_SERVICE_KEY=eyJhbGciOi...  # service_role secret (NUNCA en frontend)

# ----- API Keys de IA -----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# https://platform.openai.com/api-keys  (solo para embeddings, ~0,01€/día)
OPENAI_API_KEY=sk-proj-...

# ----- Seguridad del cron -----
# Genera una cadena aleatoria larga. PowerShell:
#   [System.Web.Security.Membership]::GeneratePassword(48, 0)
# O usa https://generate-secret.vercel.app/48
CRON_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# ----- Deployment -----
# Vercel la autorellena, pero en local pon la URL donde corres
DEPLOYMENT_URL=https://lente.app
