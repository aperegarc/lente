{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": true,
  "cleanUrls": true,

  "buildCommand": null,
  "outputDirectory": "public",

  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/chart/:path*", "destination": "/index.html" },
    { "source": "/api/cron/ingest", "destination": "/api/crons?job=ingest" },
    { "source": "/api/cron/generate", "destination": "/api/crons?job=generate" },
    { "source": "/api/cron/markets-update", "destination": "/api/crons?job=markets-update" },
    { "source": "/api/cron/markets", "destination": "/api/crons?job=markets" }
  ],

  "functions": {
    "api/stripe/webhook.js": {
      "maxDuration": 30
    }
  },

  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/markets-update",
      "schedule": "0 6 * * *"
    }
  ]
}
