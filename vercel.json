{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "public",

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/fonts/(.*).woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/config.js", "destination": "/api/public-config" },
    { "source": "/api/session", "destination": "/api/public-config?op=session" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/aviso-legal", "destination": "/legal/aviso.html" },
    { "source": "/privacidad", "destination": "/legal/privacidad.html" },
    { "source": "/cookies", "destination": "/legal/cookies.html" },
    { "source": "/terminos", "destination": "/legal/terminos.html" },
    { "source": "/transparencia-ia", "destination": "/legal/ia.html" },
    { "source": "/chart/:path*", "destination": "/index.html" },
    { "source": "/api/cron/ingest", "destination": "/api/crons?job=ingest" },
    { "source": "/api/cron/generate", "destination": "/api/crons?job=generate" },
    { "source": "/api/cron/markets", "destination": "/api/crons?job=markets" }
  ],

  "functions": {
    "api/stripe/webhook.js": {
      "maxDuration": 30
    }
  },

  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/markets",
      "schedule": "0 6 * * *"
    }
  ]
}
